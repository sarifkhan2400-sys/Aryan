<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fitsSystemWindows="true">

    <!-- Red Screen Effect Overlay -->
    <View
        android:id="@+id/redOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF1744"
        android:alpha="0.0"
        android:elevation="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:elevation="2dp">

        <!-- Top Utility Bar: Time & Settings -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <!-- Time Bento Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bento_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="--:--" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Settings Bento Button -->
            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_bento_pill"
                android:contentDescription="Settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="#888888" />
        </LinearLayout>

        <!-- Bento Grid Header (4 Columns: 1 + 2 + 1) -->
        <LinearLayout
            android:id="@+id/bentoGridHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <!-- Bento Card 1 (Col 1): Battery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_bento_card_red"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#FF1744"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="88%" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.15"
                    android:text="BATT"
                    android:textColor="#555555"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Bento Card 2 (Col 2-3): ARYAN Title & Version -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_bento_card_center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.3"
                    android:text="ARYAN"
                    android:textColor="#FF1744"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="AI COMPANION v1.0"
                    android:textColor="#555555"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Bento Card 3 (Col 4): RAM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_bento_card_purple"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/ramText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#D500F9"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="2.4GB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.15"
                    android:text="RAM"
                    android:textColor="#555555"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Section: Orb, Waveform, Status -->
        <LinearLayout
            android:id="@+id/centerContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <com.aryan.assistant.ui.main.OrbAnimationView
                android:id="@+id/orbView"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center" />

            <com.aryan.assistant.ui.main.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="200dp"
                android:layout_height="36dp"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="বলতে ট্যাপ করুন / Tap to speak 💬"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Chat History Recycler (Bento space-y-3) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecycler"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:stackFromEnd="true" />

        <!-- Bottom Controls (Bento gradient dock) -->
        <LinearLayout
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_gradient"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- Mic Button with Shadow & Border -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_mic_button"
                    android:contentDescription="Microphone"
                    android:padding="16dp"
                    android:src="@drawable/ic_mic_off" />
            </FrameLayout>

            <TextView
                android:id="@+id/hintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:text="LONG PRESS TO STOP SESSION"
                android:textColor="#555555"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
